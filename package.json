{
  "name": "sortify",
  "version": "1.0.0",
  "private": true,
  "description": "Spotify-Songs in Playlists einsortieren (sortify.veerka.mp)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "types": "wrangler types",
    "deploy": "vite build && wrangler deploy",
    "test": "esbuild test/walker.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=dist/test/walker.mjs && node --test dist/test/walker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true,
    "workerd@1.20261113.1": true
  }
}
